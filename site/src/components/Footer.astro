---
import settings from "../settings.json";
interface Props { cloudNote?: boolean; }
const { cloudNote = false } = Astro.props;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/">{settings.product}</a>
        <p class="tagline">Matter management for law firms on Google Workspace. Made by {settings.company} in {settings.place}.</p>
      </div>
      <div>
        <h2>Product</h2>
        <ul>{settings.menu.map((m) => <li><a href={m.href}>{m.label}</a></li>)}</ul>
      </div>
      <div>
        <h2>Company</h2>
        <ul>
          <li><a href={settings.companySite}>Pangur Labs</a></li>
          <li><a href={`mailto:${settings.email.hello}`}>{settings.email.hello}</a></li>
          <li><a href={`mailto:${settings.email.support}`}>{settings.email.support}</a></li>
        </ul>
      </div>
      <div>
        <h2>Legal</h2>
        <ul>{settings.legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
    </div>
    {cloudNote && <p class="footer-note">{settings.cloudNote}</p>}
    <p class="footer-base">© {settings.year} {settings.company} · {settings.place}. Pangur Labs isn't a law firm and doesn't give legal advice.</p>
  </div>
</footer>
